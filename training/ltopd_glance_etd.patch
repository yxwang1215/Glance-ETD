+# ------------------------------------------------------------------------------------------------------- entry point
+class EfficientViTState:
+    """Per-compressor scratch: aux losses recorded during the actor forward and the last call's stats."""
+
+    def __init__(self) -> None:
+        self.records: list[torch.Tensor] = []
+        self.last_stats: dict[str, float] = {}
+        self.calls = 0
+
+
+def efficient_visual_forward(visual, pixel_values: torch.Tensor, grid: torch.Tensor, cfg: Mapping[str, Any],
+                             state: Optional[EfficientViTState] = None) -> torch.Tensor:
+    """Drop-in for ``visual(pixel_values, grid_thw=grid).pooler_output`` on the student path."""
+    rows = [tuple(int(v) for v in row) for row in grid.tolist()]
+    sizes = [t * h * w for t, h, w in rows]
+    merge = visual.spatial_merge_size
+    big = [i for i, (t, h, w) in enumerate(rows) if t * h * w >= cfg["min_patches"] and (cfg["mode"] == "window" or t == 1)]
+    if not big:
+        return visual(pixel_values, grid_thw=grid).pooler_output
+    starts = [0]
+    for n in sizes:
+        starts.append(starts[-1] + n)
+    small = [i for i in range(len(rows)) if i not in big]
+    outputs: list[Optional[torch.Tensor]] = [None] * len(rows)
+    if small:
+        idx = torch.cat([torch.arange(starts[i], starts[i + 1], device=pixel_values.device) for i in small])
+        dense = visual(pixel_values.index_select(0, idx), grid_thw=grid[small]).pooler_output
+        offset = 0
+        for i in small:
+            n = sizes[i] // (merge * merge)
+            outputs[i] = dense[offset: offset + n]
+            offset += n
+    stats = {"evit/images": float(len(big)), "evit/native_patches": float(sum(sizes[i] for i in big)),
+             "evit/encoded_patches": 0.0}
+    if cfg["mode"] == "window":
+        idx = torch.cat([torch.arange(starts[i], starts[i + 1], device=pixel_values.device) for i in big])
+        fast = window_forward(visual, pixel_values.index_select(0, idx), grid[big], cfg)
+        offset = 0
+        for i in big:
+            n = sizes[i] // (merge * merge)
+            outputs[i] = fast[offset: offset + n]
+            offset += n
+        stats["evit/encoded_patches"] = stats["evit/native_patches"]
+    else:
+        for i in big:
+            _, h, w = rows[i]
+            outputs[i], one = glance_forward_one(visual, pixel_values[starts[i]: starts[i + 1]], h, w, cfg)
+            stats["evit/encoded_patches"] += one["pass1_patches"] + one["pass2_patches"]
+    result = torch.cat(outputs, dim=0)
+    if state is not None:
+        state.calls += 1
+        state.last_stats = stats
+        coef = float(cfg["feature_distill_coef"])
+        if coef > 0 and torch.is_grad_enabled() and visual.training:
+            idx = torch.cat([torch.arange(starts[i], starts[i + 1], device=pixel_values.device) for i in big])
+            with torch.no_grad():
+                target = visual(pixel_values.index_select(0, idx), grid_thw=grid[big]).pooler_output
+            student = torch.cat([outputs[i] for i in big], dim=0)
+            loss = (1.0 - F.cosine_similarity(student.float(), target.float(), dim=-1)).mean()
+            state.records.append(loss)
+    return result
+
+
+def pop_aux_loss(module) -> tuple[Optional[torch.Tensor], dict[str, float], Optional[float]]:
+    """Find the efficient-ViT compressor under ``module``; return (mean aux loss, metrics, coef) and clear records."""
+    for sub in module.modules():
+        compressor = sub.__dict__.get("_modules", {}).get("vision_token_compressor")
+        cfg = getattr(compressor, "efficient_vit_config", None) if compressor is not None else None
+        if cfg and cfg.get("enabled"):
+            state = compressor.efficient_vit_state
+            records, state.records = state.records, []
+            metrics = {"evit/feature_cos_loss": 0.0, "evit/aux_images": float(len(records))}
+            if not records:
+                return None, metrics, cfg["feature_distill_coef"]
+            loss = torch.stack(records).mean()
+            metrics["evit/feature_cos_loss"] = float(loss.detach())
+            return loss, metrics, cfg["feature_distill_coef"]
+    return None, {}, None
+
+
+def clear_aux(module) -> None:
+    for sub in module.modules():
+        compressor = sub.__dict__.get("_modules", {}).get("vision_token_compressor")
+        state = getattr(compressor, "efficient_vit_state", None) if compressor is not None else None
+        if state is not None:
+            state.records = []
