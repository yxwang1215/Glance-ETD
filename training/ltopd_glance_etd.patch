+def validate_importance_config(config: Optional[Mapping[str, Any]]) -> dict[str, Any]:
+    """Learnable selector settings; disabled unless ``enabled: true``.
+
+    mode (query-aware selectors; ``ste`` without ``query_aware`` is LES):
+      ste   straight-through gate on retained slots (first-order "scale this slot" attribution)
+      csd   counterfactual swap distillation: every discarded token's first-order loss change if it replaced
+            its slot anchor, distilled into the scorer with a per-slot ListNet loss (autograd tap)
+      ted   teacher evidence distillation: the frozen dense teacher's answer->image affinity map is the target
+      pgs   policy-gradient selection: Gumbel-perturbed selection at rollout, REINFORCE with -KL(student||teacher)
+      qslot query-conditioned learnable soft patches appended to every image span (selection stays DivPrune)
+    """
+    config = dict(config or {})
+    allowed = {"enabled", "lambda", "hidden_size", "clip", "mode", "query_aware", "coef", "temperature",
+               "explore_tau", "num_slots", "ted_layer", "ted_tau", "pgs_ema", "ted_standardize",
+               "selector_arch", "init_checkpoint", "split_ratio", "text_coef", "box_coef", "svh_coef", "svh_heads",
+               "svh_min_tokens", "budget_adaptive", "budget_m_lo", "budget_m_hi", "budget_kmax", "tilt_beta", "tilt_const"}
+    unknown = set(config) - allowed
+    if unknown:
+        raise ValueError(f"Unknown importance settings: {sorted(unknown)}")
+    out = {
+        "enabled": bool(config.get("enabled", False)),
+        "lambda": float(config.get("lambda", 1.0)),
+        "hidden_size": int(config.get("hidden_size", 64)),
+        "clip": float(config.get("clip", 3.0)),
+        "mode": str(config.get("mode", "ste")),
+        "query_aware": bool(config.get("query_aware", False)),
+        "coef": float(config.get("coef", 1.0)),
+        "temperature": float(config.get("temperature", 1.0)),
+        "explore_tau": float(config.get("explore_tau", 0.0)),
+        "num_slots": int(config.get("num_slots", 0)),
+        "ted_layer": int(config.get("ted_layer", -1)),
+        "ted_tau": float(config.get("ted_tau", 0.1)),
+        "pgs_ema": float(config.get("pgs_ema", 0.95)),
+        # z-score each answer token's image affinities before the temperature (v8 targets were ~uniform).
+        "ted_standardize": bool(config.get("ted_standardize", False)),
+        # BG-OPD (mode=box): box-label-supervised QuerySelector (evidence-scorer architecture).
+        "selector_arch": str(config.get("selector_arch", "mlp")),
+        "init_checkpoint": config.get("init_checkpoint"),
+        "split_ratio": float(config.get("split_ratio", 0.5)),
+        "text_coef": float(config.get("text_coef", 0.2)),
+        "box_coef": float(config.get("box_coef", 1.0)),
+        # SparseMM-style visual heads of the dense teacher: scored on box-labeled rows the student answered
+        # correctly, then their answer->image attention is the selector target on every row.
+        "svh_coef": float(config.get("svh_coef", 0.0)),
+        "svh_heads": int(config.get("svh_heads", 6)),
+        "svh_min_tokens": int(config.get("svh_min_tokens", 200)),
+        # adaptive per-image budget (box mode only).
+        "budget_adaptive": bool(config.get("budget_adaptive", False)),
+        "budget_m_lo": float(config.get("budget_m_lo", 0.6)),
+        "budget_m_hi": float(config.get("budget_m_hi", 3.0)),
+        "budget_kmax": float(config.get("budget_kmax", 0.25)),
+        # ETD (box mode): > 0 replaces the forced top split with DivPrune multipliers (N p)^(beta t).
