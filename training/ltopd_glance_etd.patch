+    cos, sin = _rope(visual, grid)
+    cos, sin = cos.index_select(0, patch_index), sin.index_select(0, patch_index)
+    cu_full = _cu([patch_index.numel()], device)
+    cu_win = None
+    if cfg["pass2_window"]:
+        # Windows over native cells; zoomed cells are already sorted by (row, col), so window ids are re-sorted.
+        ws = cfg["window_units"]
+        key = (native_units // gw // ws) * math.ceil(gw / ws) + (native_units % gw) // ws
+        order = torch.sort(key, stable=True).indices
+        perm = (order.view(-1, 1) * unit + torch.arange(unit, device=device).view(1, -1)).reshape(-1)
+        hidden, cos, sin = hidden[perm], cos[perm], sin[perm]
+        cu_win = _cu((torch.bincount(key)[torch.bincount(key) > 0] * unit).tolist(), device)
+    hidden = _run_blocks(visual, hidden, (cos, sin), cu_full, cu_win, set(cfg["global_layers"]))
+    if cu_win is not None:
+        inverse = torch.empty_like(perm)
+        inverse[perm] = torch.arange(perm.numel(), device=device)
+        hidden = hidden[inverse]
+    fine = visual.merger(hidden)
+    output = output.index_copy(0, native_units, fine.to(output.dtype))
+    stats.update(zoom_cells=int(chosen.numel()), pass2_patches=int(patch_index.numel()))
+    return output, stats
+
