+            raise ValueError("QueryAwareScorer needs non-empty [query_tokens, hidden] question embeddings")
+        keys, values = self._query_context(query_embeds)
+        q_unit = F.normalize(query_embeds.detach().float(), dim=-1)
+        scale = 1.0 / math.sqrt(self.hidden_size)
+        scores = []
+        for start in range(0, embeds.shape[0], chunk_tokens):
+            chunk = embeds[start:start + chunk_tokens]
+            h = self.input(self._normed(chunk))
+            attention = torch.softmax((h @ keys.transpose(0, 1)).float() * scale, dim=-1).to(h.dtype)
+            c = attention @ values
+            learned = self.output(F.gelu(h + c + h * c)).squeeze(-1).float()
+            relevance = (F.normalize(chunk.detach().float(), dim=-1) @ q_unit.transpose(0, 1)).amax(dim=-1)
+            scores.append(learned + self.relevance_weight.float() * relevance)
+        return torch.cat(scores, dim=0)
+
+    def slots(self, embeds: torch.Tensor, query_embeds: torch.Tensor) -> torch.Tensor:
+        """QSlot: num_slots query-conditioned convex combinations of the image's post-merger tokens.
+
+        Slot m attends over all N tokens with query (slot_queries[m] + mean question value).  Outputs are convex
+        combinations of real embeddings (same scale as image tokens; never the zero vector that broke the DINO
+        tokens' RMSNorm), and gradients reach the vision tower through the values.
+        """
+        if self.num_slots <= 0:
+            raise RuntimeError("QSlot is disabled for this scorer")
+        _, values = self._query_context(query_embeds)
+        slot_query = self.slot_queries.to(values.dtype) * 0.02 + values.mean(dim=0, keepdim=True)
+        keys = self.slot_key(self._normed(embeds))
+        logits = (slot_query @ keys.transpose(0, 1)).float() / math.sqrt(self.hidden_size)
+        attention = torch.softmax(logits * torch.exp(self.slot_log_scale.float()).clamp(max=100.0), dim=-1)
+        return (attention.to(embeds.dtype) @ embeds)
+
+
+def _sincos_2d(rows: torch.Tensor, cols: torch.Tensor, gh: int, gw: int, dim: int) -> torch.Tensor:
+    """2-D sine-cosine embedding of normalized cell centers (identical to scorer/train_selector.py)."""
+    y = (rows.float() + 0.5) / gh
+    x = (cols.float() + 0.5) / gw
+    freq = torch.exp(torch.arange(dim // 4, device=rows.device) * (-math.log(100.0) / max(dim // 4 - 1, 1)))
+    parts = []
+    for p in (y, x):
+        a = p[:, None] * freq[None] * math.pi * 8
+        parts += [a.sin(), a.cos()]
+    return torch.cat(parts, dim=-1)
+
+
+def grid_from_coordinates(coordinates: torch.Tensor) -> tuple[torch.Tensor, torch.Tensor, int, int]:
+    """Merged-token (row, col) and grid size from one image span's M-RoPE (t, h, w) coordinates."""
+    rows = coordinates[:, 1].long() - coordinates[:, 1].long().min()
+    cols = coordinates[:, 2].long() - coordinates[:, 2].long().min()
+    gh, gw = int(rows.max()) + 1, int(cols.max()) + 1
+    if gh * gw != coordinates.shape[0]:
+        raise ValueError(f"image span is not a full {gh}x{gw} grid ({coordinates.shape[0]} tokens)")
+    return rows, cols, gh, gw
+
+
+def box_coverage(rows: torch.Tensor, cols: torch.Tensor, gh: int, gw: int, boxes: torch.Tensor) -> torch.Tensor:
+    """Per-token fraction of the token cell covered by each normalized box: [num_boxes, N] (float32)."""
+    y0, y1 = rows.float() / gh, (rows + 1).float() / gh
+    x0, x1 = cols.float() / gw, (cols + 1).float() / gw
+    b = boxes.float().to(rows.device)
+    ix = (torch.minimum(x1[None], b[:, 2:3]) - torch.maximum(x0[None], b[:, 0:1])).clamp_min(0)
+    iy = (torch.minimum(y1[None], b[:, 3:4]) - torch.maximum(y0[None], b[:, 1:2])).clamp_min(0)
+    return (ix * iy * gh * gw).clamp(max=1.0)
+
+
+class QSelScorer(nn.Module):
+    """BG-OPD scorer: the evidence scorer of scorer/train_selector.py, same parameter names,
+    so its box-label-pretrained checkpoint loads directly. Returns (answer-relevance logits, text logits)."""
+
+    def __init__(self, input_hidden_size: int, hidden_size: int = 256, heads: int = 4,
+                 init_checkpoint: Optional[str] = None) -> None:
+        super().__init__()
+        d, h = int(input_hidden_size), int(hidden_size)
+        self.h = h
+        self.v = nn.Sequential(nn.LayerNorm(d), nn.Linear(d, h))
+        self.q = nn.Sequential(nn.LayerNorm(d), nn.Linear(d, h))
+        self.pos = nn.Linear(h, h)
+        self.cross = nn.MultiheadAttention(h, heads, batch_first=True)
+        self.out = nn.Sequential(nn.LayerNorm(3 * h), nn.Linear(3 * h, h), nn.GELU(), nn.Linear(h, 2))
+        self.init_source = None
+        if init_checkpoint:
+            from pathlib import Path as _Path
+            path = _Path(init_checkpoint)
+            if not path.is_file():
+                raise FileNotFoundError(f"QSel init checkpoint not found: {init_checkpoint}")
+            payload = torch.load(str(path), map_location="cpu", weights_only=False)
+            if int(payload.get("hidden", h)) != h or int(payload.get("d", d)) != d:
+                raise ValueError(f"QSel checkpoint shape mismatch: {payload.get('d')}x{payload.get('hidden')} vs {d}x{h}")
+            self.load_state_dict(payload["state_dict"], strict=True)
+            self.init_source = str(path)
+            print(f"[BG-OPD] QSel scorer initialized from {path}", flush=True)
+
+    def forward(self, v: torch.Tensor, q: torch.Tensor, coordinates: torch.Tensor) -> tuple[torch.Tensor, torch.Tensor]:
+        rows, cols, gh, gw = grid_from_coordinates(coordinates)
+        dtype = self.v[1].weight.dtype
+        hv = self.v(v.detach().to(dtype)) + self.pos(_sincos_2d(rows, cols, gh, gw, self.h).to(dtype))
+        hq = self.q(q.detach().to(dtype))
+        ctx, _ = self.cross(hv[None], hq[None], hq[None], need_weights=False)
+        ctx = ctx[0]
+        pooled = hq.mean(0, keepdim=True).expand_as(hv)
+        logits = self.out(torch.cat([hv, ctx, hv * pooled], dim=-1)).float()
+        return logits[:, 0], logits[:, 1]
+
+
+def box_label_losses(rel: torch.Tensor, txt: torch.Tensor, coordinates: torch.Tensor, boxes: torch.Tensor,
+                     kinds: torch.Tensor, *, text_coef: float) -> tuple[Optional[torch.Tensor], dict]:
+    """SparseMM-style alignment target: every answer box maps to the merged tokens it covers; each box's coverage is
+    normalized by its own size (a small box concentrates its unit mass, as SparseMM's 1/|I_y| hit weight), and the
+    target is the mean over boxes. Loss = CE(softmax(rel), target) + text_coef * BCE(txt, any-OCR-box coverage).
+    ``info["answer_mask"]`` is the set of tokens touched by any answer box (SparseMM's I_y)."""
+    rows, cols, gh, gw = grid_from_coordinates(coordinates)
+    answer = boxes[kinds == 1]
+    ocr = boxes[kinds == 2]
+    terms, info = [], {}
+    if answer.numel():
+        cover = box_coverage(rows, cols, gh, gw, answer)
+        mass = cover.sum(dim=1)
+        cover = cover[mass > 0]
+        if cover.numel():
+            target = (cover / cover.sum(dim=1, keepdim=True)).mean(dim=0)
+            terms.append(-(target * torch.log_softmax(rel.float(), dim=0)).sum())
+            budget = max(1, min(rel.numel(), max(32, math.ceil(0.05 * rel.numel()))))
+            top = torch.topk(rel.detach(), budget).indices
+            info["recall"] = float(target[top].sum())
+            info["answer_mask"] = (cover.amax(dim=0) > 0).detach()
+    if ocr.numel() and text_coef > 0:
+        any_text = (box_coverage(rows, cols, gh, gw, ocr).amax(dim=0) > 0).float()
+        terms.append(text_coef * F.binary_cross_entropy_with_logits(txt.float(), any_text))
+    if not terms:
+        return None, info
+    return sum(terms), info
+
+
+def _group_softmax(values: torch.Tensor, groups: torch.Tensor, num_groups: int) -> torch.Tensor:
+    values = values.float()
+    maxima = values.new_full((num_groups,), -torch.inf).scatter_reduce(0, groups, values, reduce="amax")
+    shifted = torch.exp(values - maxima.index_select(0, groups))
+    totals = values.new_zeros((num_groups,)).scatter_add(0, groups, shifted)
+    return shifted / totals.index_select(0, groups).clamp_min(1e-20)
+
+
+class _SwapGainTap(torch.autograd.Function):
+    """CSD: identity on the reduced slots; in backward, turns the slot gradients into a scorer gradient.
+
+    For a discarded token i assigned to slot k (anchor a_k), the first-order change of the OPD loss if i
+    replaced a_k is  dL ~= <g_k, x_i - x_{a_k}>.  gain_i = -dL is normalised per image and turned into a
+    per-slot target distribution p = softmax_group(gain / T) (the anchor has gain 0).  The scorer's per-slot
+    softmax q receives the ListNet / KL(p || q) gradient  coef * (q - p) / K.
+    """
+
+    @staticmethod
+    def forward(ctx, reduced, scores, sources, selected, assignment, coef, temperature, chunk_tokens):
+        ctx.save_for_backward(scores.detach(), sources.detach(), selected, assignment)
+        ctx.coef, ctx.temperature, ctx.chunk_tokens = float(coef), float(temperature), int(chunk_tokens)
+        return reduced.clone()
+
+    @staticmethod
+    def backward(ctx, grad_reduced):
+        scores, sources, selected, assignment = ctx.saved_tensors
+        grad_scores = None
+        if ctx.needs_input_grad[1] and grad_reduced is not None:
+            with torch.no_grad():
+                g = grad_reduced.float()
+                k = g.shape[0]
+                anchor_dot = (g * sources.index_select(0, selected).float()).sum(-1)
+                gain = torch.empty(sources.shape[0], device=g.device, dtype=torch.float32)
+                for start in range(0, sources.shape[0], ctx.chunk_tokens):
+                    end = min(start + ctx.chunk_tokens, sources.shape[0])
+                    slots = assignment[start:end]
+                    gain[start:end] = -((g.index_select(0, slots) * sources[start:end].float()).sum(-1)
+                                        - anchor_dot.index_select(0, slots))
+                gain[selected] = 0.0
+                scale = gain.abs().mean().clamp_min(1e-20)
+                target = _group_softmax(gain / scale / ctx.temperature, assignment, k)
+                predicted = _group_softmax(scores, assignment, k)
+                grad_scores = (ctx.coef * (predicted - target) / k).to(scores.dtype)
+        return grad_reduced, grad_scores, None, None, None, None, None, None
+
