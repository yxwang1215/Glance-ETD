+"""OPD variants for LT-OPD (visual-token-compressed on-policy self-distillation).
+
+Two weighting schemes, both detached and both preserving the vanilla optimum (the student still matches the
+frozen dense teacher; only *where* the distillation budget goes changes):
+
+* SVG-OPD (self-view compression gap). The student is run twice on its own rollout: once on the compressed
+  view it is trained on, once (no grad) on the full dense view. Same weights, different visual input, so the
+  per-token divergence isolates what *this image's token selection* threw away, independent of any
+  teacher/student weight mismatch. Tokens with a large view gap (text strings, counts, spatial words) are
+  up-weighted.
+
+* OC-OPD (outcome-calibrated). Training rows carry gold answers. Sequences where the student's on-policy
+  answer is wrong are boosted; on MCQ rows where the frozen dense teacher itself prefers a wrong option, the
+  sequence is damped so the student is not pulled toward the teacher's error.
+
+All helpers are pure tensor functions so they can be unit-tested on CPU.
+"""
+from __future__ import annotations
+
+import math
+import re
+from typing import Optional, Sequence
+
+import torch
+
+# --------------------------------------------------------------------------------------------- distributions
+_NEG = -1.0e9
+
+
+def add_tail(log_probs: torch.Tensor) -> torch.Tensor:
+    """Append the tail bucket log(1 - sum p) exactly as compute_self_distillation_loss does."""
+    log_s = torch.logsumexp(log_probs, dim=-1, keepdim=True).clamp(max=-1e-7)
+    return torch.cat([log_probs, torch.log(-torch.expm1(log_s))], dim=-1)
+
+
+def support_distribution(topk_log_probs: torch.Tensor, valid_mask: Optional[torch.Tensor]) -> torch.Tensor:
+    """Top-k support log-probs (+tail bucket) as a proper distribution, in float32."""
+    lp = topk_log_probs.detach().float()
+    if valid_mask is not None:
+        lp = lp.masked_fill(~valid_mask.bool(), _NEG)
+    return add_tail(lp)
+
+
+def token_jsd(p_log: torch.Tensor, q_log: torch.Tensor) -> torch.Tensor:
+    """Symmetric Jensen-Shannon divergence over the last axis (log-prob inputs), shape [..., ]."""
+    m_log = torch.logsumexp(torch.stack([p_log, q_log]), dim=0) - math.log(2.0)
+    p = p_log.exp()
+    q = q_log.exp()
+    kl_pm = (p * (p_log - m_log)).sum(-1)
+    kl_qm = (q * (q_log - m_log)).sum(-1)
+    return (0.5 * (kl_pm + kl_qm)).clamp(min=0.0)
+
+
+# --------------------------------------------------------------------------------------------- SVG-OPD
+def svg_token_weights(
+    student_dense_topk: torch.Tensor,
+    student_merge_topk: torch.Tensor,
+    valid_mask: Optional[torch.Tensor],
+    response_mask: torch.Tensor,
+    *,
+    eta: float = 0.5,
+    max_weight: float = 5.0,
+    eps: float = 1e-6,
+) -> tuple[torch.Tensor, torch.Tensor]:
+    """Per-token weights from the student's own dense-vs-compressed view gap.
+
+    w_t = (1 - eta) + eta * clip(g_t / mean_seq(g), 0, max_weight), normalised so every sequence keeps mean 1
+    over its response tokens (the seq-mean-token-mean objective keeps its per-sequence scale).
+    Returns (weights [B, T], gap [B, T]); both detached, zero outside response_mask.
+    """
+    if student_dense_topk.shape != student_merge_topk.shape:
+        raise ValueError("dense and compressed student supports must have the same shape")
+    mask = response_mask.to(torch.float32)
+    gap = token_jsd(
+        support_distribution(student_dense_topk, valid_mask),
+        support_distribution(student_merge_topk, valid_mask),
+    ) * mask
+    count = mask.sum(-1, keepdim=True).clamp(min=1.0)
+    mean_gap = gap.sum(-1, keepdim=True) / count
+    rel = (gap / (mean_gap + eps)).clamp(0.0, max_weight)
+    weights = ((1.0 - eta) + eta * rel) * mask
+    weights = weights / ((weights.sum(-1, keepdim=True) / count).clamp(min=eps))
+    return (weights * mask).detach(), gap.detach()
+
+
+# --------------------------------------------------------------------------------------------- OC-OPD
+VERIFIABLE = {"mcq", "math", "numerical", "regression", "text_vqa", "ocr"}
+_NUM = re.compile(r"[-+]?\d*\.?\d+(?:[eE][-+]?\d+)?")
+
+
+def _normalize_text(text: str) -> str:
+    text = text.lower().strip()
+    text = re.sub(r"\s+", " ", text)
+    return text.strip(" .!?;:'\"")
+
+
+def extract_answer(response_text: str) -> str:
+    """Response is prefixed with <answer> by the prompt protocol; keep text before </answer>."""
+    text = response_text.split("</answer>", 1)[0]
+    text = text.replace("<answer>", "")
+    return text.strip()
+
+
+def _to_float(text: str) -> Optional[float]:
+    match = _NUM.search(text.replace(",", ""))
+    if not match:
+        return None
+    try:
+        return float(match.group(0))
+    except ValueError:
+        return None
+
+
+def judge_answer(task_type: str, response_text: str, gold: str) -> int:
+    """1 correct, 0 wrong, -1 not verifiable (open-ended rows or missing gold)."""
+    if task_type not in VERIFIABLE or gold is None or str(gold).strip() == "":
+        return -1
+    pred = extract_answer(response_text)
+    gold = str(gold).strip()
+    if task_type == "mcq":
+        letter = re.match(r"\s*\(?([A-Za-z])\b", pred)
+        return int(bool(letter) and letter.group(1).upper() == gold.upper()[:1])
+    if task_type in {"math", "numerical", "regression"}:
+        g, p = _to_float(gold), _to_float(pred)
+        if g is None:
+            return int(_normalize_text(pred) == _normalize_text(gold))
+        if p is None:
+            return 0
+        tol = 0.01 * abs(g) if task_type == "regression" else 1e-6 * max(1.0, abs(g))
+        return int(abs(p - g) <= tol)
+    return int(_normalize_text(pred) == _normalize_text(gold))
+
+
+def mcq_gold_token_ids(tokenizer, task_type: str, gold: str) -> tuple[int, int]:
+    """Token ids a dense teacher would emit first for the gold MCQ letter ("C" and " C"); -1 if not MCQ."""
+    if task_type != "mcq" or not gold:
+        return (-1, -1)
+    letter = str(gold).strip()[:1].upper()
+    ids = []
+    for text in (letter, " " + letter):
+        enc = tokenizer.encode(text, add_special_tokens=False)
+        ids.append(int(enc[0]) if len(enc) == 1 else -1)
+    return (ids[0], ids[1])
+
+
+def teacher_first_token_wrong(
+    teacher_topk: torch.Tensor,
+    support_indices: torch.Tensor,
+    valid_mask: Optional[torch.Tensor],
+    gold_tokens: torch.Tensor,
+    response_mask: torch.Tensor,
+) -> torch.Tensor:
+    """Bool [B]: MCQ rows where the dense teacher's argmax first response token is not a gold-letter token.
+
+    The union support always contains the teacher's own top-k, so argmax over the support is the teacher argmax.
+    Rows with gold_tokens == -1 (non-MCQ) or an empty first position are never flagged.
+    """
+    first = teacher_topk[:, 0, :].detach().float()
+    if valid_mask is not None:
+        first = first.masked_fill(~valid_mask[:, 0, :].bool(), _NEG)
+    arg = first.argmax(-1, keepdim=True)
+    token = support_indices[:, 0, :].gather(-1, arg).squeeze(-1)
+    gold_tokens = gold_tokens.to(token.device)
+    is_mcq = (gold_tokens >= 0).any(-1) & (response_mask[:, 0] > 0)
+    hit = (token.unsqueeze(-1) == gold_tokens).any(-1)
+    return is_mcq & ~hit
+
+
+def outcome_sequence_weights(
+    student_correct: torch.Tensor,
+    teacher_wrong: torch.Tensor,
+    *,
+    wrong_boost: float = 1.0,
+    teacher_wrong_weight: float = 0.25,
+    eps: float = 1e-6,
+) -> torch.Tensor:
+    """Per-sequence weights [B], mean-normalised to 1 within the micro-batch.
+
+    student wrong (0)            -> 1 + wrong_boost
+    teacher wrong (MCQ)          -> teacher_wrong_weight (overrides the boost)
+    correct / not verifiable     -> 1
+    """
+    w = torch.ones_like(student_correct, dtype=torch.float32)
+    w = torch.where(student_correct == 0, torch.full_like(w, 1.0 + wrong_boost), w)
+    w = torch.where(teacher_wrong.bool(), torch.full_like(w, teacher_wrong_weight), w)
+    return (w / w.mean().clamp(min=eps)).detach()
+
+
+def batch_outcome_tensors(
+    tokenizer,
+    responses: torch.Tensor,
+    response_mask: torch.Tensor,
+    task_types: Sequence[str],
+    answers: Sequence[str],
+) -> tuple[torch.Tensor, torch.Tensor, dict[str, float]]:
+    """Trainer-side: decode rollouts and build (student_correct [B] long, gold_tokens [B,2] long, metrics)."""
+    lengths = response_mask.sum(-1).tolist()
+    correct, gold = [], []
+    for row, (task, ans) in enumerate(zip(task_types, answers)):
+        ids = responses[row, : int(lengths[row])].tolist()
+        text = tokenizer.decode(ids, skip_special_tokens=False)
+        correct.append(judge_answer(str(task), text, ans))
+        gold.append(mcq_gold_token_ids(tokenizer, str(task), ans))
+    student_correct = torch.tensor(correct, dtype=torch.long)
+    gold_tokens = torch.tensor(gold, dtype=torch.long)
+    verifiable = student_correct >= 0
+    metrics = {
+        "outcome/verifiable_frac": verifiable.float().mean().item(),
+        "outcome/student_acc": (student_correct[verifiable] == 1).float().mean().item() if verifiable.any() else float("nan"),
+    }
+    return student_correct, gold_tokens, metrics
