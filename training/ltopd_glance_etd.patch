+++ b/learnable_merge/selector_methods.py
@@ -0,0 +1,538 @@
+"""actor-side pieces of the query-aware learnable selectors (TED and PGS auxiliary losses).
+
+The compressor (verl/models/transformers/vision_token_compressor.py) records, for every compressed image of
+the student's training forward, the differentiable query-conditioned scores over all N post-merger tokens
+(``compressor.selector_records``).  This module turns them into an auxiliary loss:
+
+* TED (teacher evidence distillation): the frozen dense teacher's answer->image affinity at one middle decoder
+  layer, captured with forward hooks during the teacher pass that OPD already runs, is the soft target.
+* PGS (policy-gradient selection): REINFORCE on the (Gumbel-perturbed) rollout selection with reward
+  -KL_hat(student || teacher) per sequence and an EMA baseline.
+
+CSD needs nothing here (it is an autograd tap inside the compressor) and STE/QSlot train through the OPD loss.
+
+BG-OPD (mode=box) adds:
+
+* box CE: the compressor's box_label_losses on rows that carry OCR / key-region boxes;
+* SVH (SparseMM visual heads, Wang et al. ICCV 2025): on box-labeled rows whose n=1 rollout is correct, each answer
+  token y is aligned to the answer-box tokens I_y, and every full-attention head of the dense teacher scores
+  1[argmax attention row in I_y] / |I_y| (``VisualHeadCapture`` + ``box_selector_loss``).  The top heads' attention
+  from the response to the image tokens is then the selector target on every row, labeled or not.
+"""
+from __future__ import annotations
+
+import json
+import math
+from typing import Any, Optional, Sequence
+
+import torch
+import torch.nn.functional as F
+from torch import nn
+
+
+def find_compressor(module: nn.Module):
+    """Return the module's query-aware CDPruner compressor, or None."""
+    for sub in module.modules():
+        compressor = sub.__dict__.get("_modules", {}).get("vision_token_compressor")
+        if compressor is not None and getattr(compressor, "query_aware_selector", False):
+            return compressor
+    return None
+
+
+def _contiguous_spans(mask: torch.Tensor) -> list[tuple[int, int]]:
+    spans, start = [], None
+    values = mask.tolist()
+    for index, value in enumerate(values):
+        if value and start is None:
+            start = index
+        elif not value and start is not None:
+            spans.append((start, index))
+            start = None
+    if start is not None:
+        spans.append((start, len(values)))
+    return spans
+
+
+class TeacherEvidenceCapture:
+    """Hooks on the dense teacher: one pre-hook for (input_ids, attention_mask), one on a decoder layer.
+
+    For every image span of every row: e = mean_t softmax_i(cos(a_t - mu, v_i - mu) / tau), where a_t are the
+    hidden states of the valid response (answer) positions, v_i those of the image tokens and mu the mean
+    image hidden state (removes the shared massive-activation direction).  Results are appended in
+    (row, span) order, matching the student's compression order.
+    """
+
+    def __init__(self, teacher: nn.Module, *, response_length: int, layer: int, tau: float, standardize: bool = False):
+        self.response_length = int(response_length)
+        self.tau = float(tau)
+        self.standardize = bool(standardize)
+        self.evidence: list[dict[str, Any]] = []
+        self._pending: Optional[tuple[torch.Tensor, torch.Tensor]] = None
+        self._row_base = 0
+        self._handles = []
+        inner = teacher
+        while hasattr(inner, "_fsdp_wrapped_module"):
+            inner = inner._fsdp_wrapped_module
+        config = getattr(inner, "config", None)
+        self.image_token_id = getattr(config, "image_token_id", None)
+        if self.image_token_id is None:
+            raise RuntimeError("TED needs config.image_token_id on the teacher")
+        layers = None
+        for name, candidate in inner.named_modules():
+            canonical = name.replace("_fsdp_wrapped_module.", "").replace("._fsdp_wrapped_module", "")
+            if isinstance(candidate, nn.ModuleList) and canonical.endswith("language_model.layers"):
+                layers = candidate
+                break
+        if layers is None or len(layers) == 0:
+            raise RuntimeError("TED could not locate the teacher's language_model.layers")
+        index = layer if layer >= 0 else (2 * len(layers)) // 3
+        if not 0 <= index < len(layers):
+            raise ValueError(f"ted_layer {layer} outside [0, {len(layers)})")
+        self.layer_index = index
+        self._handles.append(inner.register_forward_pre_hook(self._pre_hook, with_kwargs=True))
+        self._handles.append(layers[index].register_forward_hook(self._layer_hook))
+
+    def _pre_hook(self, module, args, kwargs):
+        input_ids = kwargs.get("input_ids", args[0] if args else None)
+        attention_mask = kwargs.get("attention_mask")
+        if input_ids is not None:
+            if attention_mask is None:
+                attention_mask = torch.ones_like(input_ids)
+            self._pending = (input_ids.detach(), attention_mask.detach())
+
+    @torch.no_grad()
+    def _layer_hook(self, module, args, output):
+        if self._pending is None:
+            return
+        hidden = output[0] if isinstance(output, (tuple, list)) else output
+        input_ids, attention_mask = self._pending
+        self._pending = None
+        if hidden.ndim != 3 or hidden.shape[:2] != input_ids.shape:
+            raise RuntimeError(f"TED hidden {tuple(hidden.shape)} does not match input_ids {tuple(input_ids.shape)}")
+        seq = input_ids.shape[1]
+        r = min(self.response_length, seq)
+        for row in range(input_ids.shape[0]):
+            valid = attention_mask[row].to(torch.bool)
+            spans = _contiguous_spans(((input_ids[row] == self.image_token_id) & valid).cpu())
+            answer = torch.nonzero(valid[seq - r:], as_tuple=False).flatten() + (seq - r)
+            h = hidden[row].float()
+            for span_index, (start, end) in enumerate(spans):
+                image = h[start:end]
+                mu = image.mean(dim=0, keepdim=True)
+                if answer.numel() == 0:
+                    evidence = torch.full((end - start,), 1.0 / (end - start), device=h.device)
+                else:
+                    keys = F.normalize(image - mu, dim=-1)
+                    queries = F.normalize(h.index_select(0, answer) - mu, dim=-1)
+                    logits = queries @ keys.transpose(0, 1)
+                    if self.standardize:
+                        logits = (logits - logits.mean(dim=-1, keepdim=True)) / logits.std(dim=-1, keepdim=True).clamp_min(1e-6)
+                    evidence = torch.softmax(logits / self.tau, dim=-1).mean(dim=0)
+                self.evidence.append({"row": self._row_base + row, "span": span_index, "evidence": evidence})
+        self._row_base += input_ids.shape[0]
+
+    def close(self):
+        for handle in self._handles:
+            handle.remove()
+        self._handles = []
+
+
+def _ordered_records(records: list[dict[str, Any]]) -> list[dict[str, Any]]:
+    counts: dict[int, int] = {}
+    ordered = []
+    for record in records:
+        span = counts.get(record["row"], 0)
+        counts[record["row"]] = span + 1
+        ordered.append({**record, "span": span})
+    return ordered
+
+
+def ted_loss(records, evidence, *, coef: float) -> tuple[Optional[torch.Tensor], dict[str, float]]:
+    """mean over images of KL(e_teacher || softmax(s))."""
+    if not records:
+        return None, {}
+    targets = {(item["row"], item["span"]): item["evidence"] for item in evidence}
+    terms, mismatched, entropy = [], 0, []
+    for record in _ordered_records(records):
+        target = targets.get((record["row"], record["span"]))
+        scores = record["scores"].float()
+        if target is None or target.numel() != scores.numel():
+            mismatched += 1
+            continue
+        target = target.to(scores.device).clamp_min(1e-12)
+        terms.append((target * (target.log() - torch.log_softmax(scores, dim=0))).sum())
+        entropy.append(float(-(target * target.log()).sum() / math.log(max(2, target.numel()))))
+    metrics = {"selector/ted_images": float(len(terms)), "selector/ted_mismatched": float(mismatched)}
+    if not terms:
+        return None, metrics
+    loss = torch.stack(terms).mean()
+    metrics["selector/ted_kl"] = float(loss.detach())
+    metrics["selector/ted_target_norm_entropy"] = sum(entropy) / len(entropy)
+    return coef * loss, metrics
+
+
+def sequence_reverse_kl(log_prob: torch.Tensor, teacher_log_prob: torch.Tensor, response_mask: torch.Tensor):
+    """Per-sequence on-policy estimate of KL(student || teacher) from the sampled tokens."""
+    mask = response_mask.to(torch.float32)
+    per_token = (log_prob.detach().float() - teacher_log_prob.detach().float()) * mask
+    return per_token.sum(dim=-1) / mask.sum(dim=-1).clamp_min(1.0)
+
+
+def pgs_loss(records, sequence_kl: torch.Tensor, stats: dict, *, coef: float, strength: float, ema: float):
+    """REINFORCE: -coef * mean_i A_row(i) * log pi(S_i) / K_i,  A = -(KL - baseline) / std (EMA, clipped)."""
+    if not records:
+        return None, {}
+    reward = -sequence_kl.float()
+    batch_mean = float(reward.mean())
+    batch_var = float(reward.var(unbiased=False)) if reward.numel() > 1 else 0.0
+    if "mean" not in stats:
+        stats["mean"], stats["var"] = batch_mean, max(batch_var, 1e-4)
+    advantage = ((reward - stats["mean"]) / math.sqrt(stats["var"] + 1e-6)).clamp(-3.0, 3.0)
+    stats["mean"] = ema * stats["mean"] + (1.0 - ema) * batch_mean
+    stats["var"] = ema * stats["var"] + (1.0 - ema) * (batch_var + (batch_mean - stats["mean"]) ** 2)
+    terms, score_std = [], []
+    for record in records:
+        scores = record["scores"].float() * float(strength)
+        selected = record["selected"]
+        k = selected.numel()
+        log_prob = (scores.index_select(0, selected).sum() - k * torch.logsumexp(scores, dim=0)) / k
+        terms.append(-advantage[record["row"]].to(log_prob.device) * log_prob)
+        score_std.append(float(record["scores"].detach().float().std()))
+    loss = torch.stack(terms).mean()
+    metrics = {
+        "selector/pgs_adv_abs": float(advantage.abs().mean()),
+        "selector/pgs_reward_mean": batch_mean,
+        "selector/pgs_baseline": stats["mean"],
+        "selector/score_std": sum(score_std) / len(score_std),
+    }
+    return coef * loss, metrics
+
+
+def score_std_metric(records) -> dict[str, float]:
+    if not records:
+        return {}
+    values = [float(record["scores"].detach().float().std()) for record in records]
+    return {"selector/score_std": sum(values) / len(values)}
+
+
+# --------------------------------------------------------------------------------------------- BG-OPD / SVH
+MAX_LABEL_BOXES = 160
+
+
+def parse_box_label(extra_info: Any) -> Optional[dict]:
+    if not isinstance(extra_info, dict):
+        return None
+    raw = extra_info.get("box_label")
+    if raw is None or raw == "":
+        return None
+    label = json.loads(raw) if isinstance(raw, str) else dict(raw)
+    if not label.get("answer_boxes"):
+        return None
+    return label
+
+
+def answer_span_mask(tokenizer, ids: Sequence[int]) -> torch.Tensor:
+    """Bool [len(ids)]: tokens that spell the answer, i.e. non-blank text before '</answer>' (the prompt pre-fills
+    '<answer>')."""
+    ids = list(ids)
+    full = tokenizer.decode(ids, skip_special_tokens=False)
+    end = full.find("</answer>")
+    end = len(full) if end < 0 else end
+    mask = torch.zeros(len(ids), dtype=torch.bool)
+    previous = 0
+    for index in range(len(ids)):
+        current = len(tokenizer.decode(ids[: index + 1], skip_special_tokens=False))
+        if previous >= end:
+            break
+        piece = tokenizer.decode(ids[index : index + 1], skip_special_tokens=False)
+        if piece.strip() and "<answer>" not in piece:
+            mask[index] = True
+        previous = current
+    return mask
+
+
+def batch_box_tensors(
+    tokenizer,
+    responses: torch.Tensor,
+    response_mask: torch.Tensor,
+    task_types: Sequence[str],
+    answers: Sequence[Optional[str]],
+    extra_infos: Sequence[Any],
+) -> tuple[dict[str, torch.Tensor], dict[str, float]]:
+    """Trainer-side BG-OPD labels: boxes [B, M, 4], kinds [B, M] (1 answer, 2 OCR, 0 pad) and the SparseMM
+    alignment mask [B, R] (answer tokens of correct rollouts on labeled rows)."""
+    from opd_variants import judge_answer
+
+    batch, length = responses.shape
+    labels = [parse_box_label(info) for info in extra_infos]
+    rows = []
+    for label in labels:
+        if label is None:
+            rows.append([])
+            continue
+        answer = [(1, box) for box in label["answer_boxes"]]
+        ocr = [(2, box) for box in (label.get("ocr_boxes") or [])]
+        rows.append((answer + ocr)[: max(MAX_LABEL_BOXES, len(answer))])
+    width = max([1] + [len(row) for row in rows])
+    boxes = torch.zeros(batch, width, 4, dtype=torch.float32)
+    kinds = torch.zeros(batch, width, dtype=torch.long)
+    aligned = torch.zeros(batch, length, dtype=torch.bool)
+    lengths = response_mask.sum(-1).tolist()
+    labeled, correct = 0, 0
+    for row, items in enumerate(rows):
+        if not items:
+            continue
+        labeled += 1
+        for slot, (kind, box) in enumerate(items):
+            kinds[row, slot] = kind
+            boxes[row, slot] = torch.tensor([float(x) for x in box])
+        ids = responses[row, : int(lengths[row])].tolist()
+        text = tokenizer.decode(ids, skip_special_tokens=False)
+        if judge_answer(str(task_types[row]), text, answers[row]) == 1:
+            correct += 1
+            aligned[row, : len(ids)] = answer_span_mask(tokenizer, ids)
+    metrics = {
+        "box/labeled_frac": labeled / max(1, batch),
+        "box/labeled_student_acc": correct / labeled if labeled else float("nan"),
+        "box/aligned_tokens": float(aligned.sum()),
+    }
+    return {"box_label_boxes": boxes, "box_label_kinds": kinds, "box_aligned_mask": aligned}, metrics
+
+
+def _unwrap(module: nn.Module) -> nn.Module:
+    while hasattr(module, "_fsdp_wrapped_module"):
+        module = module._fsdp_wrapped_module
+    return module
+
+
+def _language_layers(inner: nn.Module) -> nn.ModuleList:
+    for name, candidate in inner.named_modules():
+        canonical = name.replace("_fsdp_wrapped_module.", "").replace("._fsdp_wrapped_module", "")
+        if isinstance(candidate, nn.ModuleList) and canonical.endswith("language_model.layers"):
+            return candidate
+    raise RuntimeError("could not locate language_model.layers")
+
+
+def full_attention_modules(model: nn.Module) -> list[nn.Module]:
+    """Softmax-attention modules of the decoder, in layer order (Qwen3.5: every 4th layer)."""
+    modules = []
+    for layer in _language_layers(_unwrap(model)):
+        attention = _unwrap(layer).__dict__.get("_modules", {}).get("self_attn")
+        if attention is not None:
+            modules.append(_unwrap(attention))
+    if not modules:
+        raise RuntimeError("no softmax self-attention layers found")
+    return modules
+
+
+def visual_head_count(model: nn.Module) -> int:
+    modules = full_attention_modules(model)
+    heads = int(modules[0].config.num_attention_heads)
+    return len(modules) * heads
+
+
+class VisualHeadCapture:
+    """Per-head teacher attention for SVH, read from the post-RoPE query/key the attention kernel receives.
+
+    While installed, the ``flash_attention_2``/``sdpa``/... entries of ``ALL_ATTENTION_FUNCTIONS`` are wrapped; only
+    calls from the teacher's full-attention modules are inspected, the kernel output is unchanged.  For every row and
+    image span (row order = teacher chunk order, same as TED):
+
+    * ``dist`` [L*H, N]: mean over valid response tokens of each head's attention restricted to the span;
+    * ``hits`` [L*H, T]: for the T aligned response tokens, the argmax of the head's full causal attention row
+      relative to the span start, -1 when the argmax is outside the span (SparseMM's hit test).
+    """
+
+    def __init__(self, teacher: nn.Module, *, response_length: int, aligned_mask: Optional[torch.Tensor]):
+        from transformers.modeling_utils import ALL_ATTENTION_FUNCTIONS
+
+        inner = _unwrap(teacher)
+        config = getattr(inner, "config", None)
+        self.image_token_id = getattr(config, "image_token_id", None)
+        if self.image_token_id is None:
+            raise RuntimeError("SVH needs config.image_token_id on the teacher")
+        self.modules = full_attention_modules(teacher)
+        self.layer_of = {id(module): index for index, module in enumerate(self.modules)}
+        self.heads = int(self.modules[0].config.num_attention_heads)
+        self.response_length = int(response_length)
+        self.aligned = aligned_mask.detach().to(torch.bool).cpu() if aligned_mask is not None else None
+        self.evidence: dict[tuple[int, int], dict[str, Any]] = {}
+        self.calls = 0
+        self._pending: Optional[tuple[torch.Tensor, torch.Tensor, list]] = None
+        self._row_base = 0
+        self._handles = [
+            inner.register_forward_pre_hook(self._pre_hook, with_kwargs=True),
+            inner.register_forward_hook(self._post_hook),
+        ]
+        self._interface = ALL_ATTENTION_FUNCTIONS
+        self._saved: dict[str, tuple[bool, Any]] = {}
+        for key in list(ALL_ATTENTION_FUNCTIONS):
+            original = ALL_ATTENTION_FUNCTIONS[key]
+            self._saved[key] = (key in ALL_ATTENTION_FUNCTIONS._local_mapping, original)
+            ALL_ATTENTION_FUNCTIONS[key] = self._wrap(original)
+
+    def _wrap(self, original):
+        def attention(module, query, key, value, attention_mask, *args, **kwargs):
+            if id(module) in self.layer_of and self._pending is not None:
+                self._capture(module, query, key)
+            return original(module, query, key, value, attention_mask, *args, **kwargs)
+
+        return attention
+
+    def _pre_hook(self, module, args, kwargs):
+        input_ids = kwargs.get("input_ids", args[0] if args else None)
+        attention_mask = kwargs.get("attention_mask")
+        if input_ids is None:
+            return
+        if attention_mask is None:
+            attention_mask = torch.ones_like(input_ids)
+        spans = []
+        for row in range(input_ids.shape[0]):
+            valid = attention_mask[row].to(torch.bool)
+            spans.append(_contiguous_spans(((input_ids[row] == self.image_token_id) & valid).cpu()))
+        self._pending = (input_ids.detach(), attention_mask.detach(), spans)
+
+    def _post_hook(self, module, args, output):
+        if self._pending is not None:
+            self._row_base += self._pending[0].shape[0]
+        self._pending = None
+
+    @torch.no_grad()
+    def _capture(self, module, query, key):
+        input_ids, attention_mask, spans = self._pending
+        batch, heads, seq, _ = query.shape
+        if seq != input_ids.shape[1] or heads != self.heads:
+            raise RuntimeError(f"SVH query {tuple(query.shape)} does not match input_ids {tuple(input_ids.shape)}")
+        self.calls += 1
+        layer = self.layer_of[id(module)]
+        group = heads // key.shape[1]
+        scale = float(getattr(module, "scaling", query.shape[-1] ** -0.5))
+        r = min(self.response_length, seq)
+        positions = torch.arange(seq, device=query.device)
+        for row in range(batch):
+            if not spans[row]:
+                continue
+            valid = attention_mask[row].to(device=query.device, dtype=torch.bool)
+            answer = torch.nonzero(valid[seq - r :], as_tuple=False).flatten() + (seq - r)
+            if answer.numel() == 0:
+                continue
+            q = query[row, :, answer].float()
+            k = key[row].float().repeat_interleave(group, dim=0)
+            logits = (q @ k.transpose(-1, -2)) * scale
+            allowed = valid[None, :] & (positions[None, :] <= answer[:, None])
+            logits = logits.masked_fill(~allowed[None], -torch.inf)
+            gid = self._row_base + row
+            aligned = None
+            if self.aligned is not None and gid < self.aligned.shape[0]:
+                offset = answer - (seq - r)
+                flags = self.aligned[gid].to(query.device)
+                aligned = flags[offset.clamp(max=flags.numel() - 1)] & (offset < flags.numel())
+                if not bool(aligned.any()):
+                    aligned = None
+            argmax = logits[:, aligned].argmax(dim=-1) if aligned is not None else None
+            for span_index, (start, end) in enumerate(spans[row]):
+                entry = self.evidence.setdefault((gid, span_index), {"dist": {}, "hits": {}})
+                entry["dist"][layer] = torch.softmax(logits[:, :, start:end], dim=-1).mean(dim=1)
+                if argmax is not None:
+                    inside = (argmax >= start) & (argmax < end)
+                    entry["hits"][layer] = torch.where(inside, argmax - start, torch.full_like(argmax, -1))
+
+    def finalize(self) -> dict[tuple[int, int], dict[str, Any]]:
+        """Stack layers into [L*H, ...]; spans missing a layer (should not happen) are dropped."""
+        layers = len(self.modules)
+        out = {}
+        for key, entry in self.evidence.items():
+            if len(entry["dist"]) != layers:
+                continue
+            dist = torch.cat([entry["dist"][index] for index in range(layers)], dim=0)
+            hits = None
+            if len(entry["hits"]) == layers:
+                hits = torch.cat([entry["hits"][index] for index in range(layers)], dim=0)
+            out[key] = {"dist": dist, "hits": hits}
+        return out
+
+    def close(self):
+        for handle in self._handles:
+            handle.remove()
+        self._handles = []
+        for key, (was_local, original) in self._saved.items():
+            if was_local:
+                self._interface[key] = original
+            elif key in self._interface._local_mapping:
+                del self._interface._local_mapping[key]
+        self._saved = {}
+
+
+def new_head_stats(num_heads: int) -> dict[str, Any]:
+    return {"local_sum": torch.zeros(num_heads, dtype=torch.float64), "local_tokens": 0.0,
+            "global_sum": torch.zeros(num_heads, dtype=torch.float64), "global_tokens": 0.0, "heads": None}
+
+
+def refresh_visual_heads(stats: dict, *, top: int, min_tokens: int, all_reduce=None) -> dict[str, float]:
+    """Merge the local SparseMM scores across ranks (``all_reduce`` sums a float64 tensor in place) and pick the
+    top heads once ``min_tokens`` aligned answer tokens have been scored."""
+    local = torch.cat([stats["local_sum"], torch.tensor([stats["local_tokens"]], dtype=torch.float64)])
+    if all_reduce is not None:
+        local = all_reduce(local)
+    stats["global_sum"] += local[:-1]
+    stats["global_tokens"] += float(local[-1])
+    stats["local_sum"].zero_()
+    stats["local_tokens"] = 0.0
+    metrics = {"selector/svh_tokens": stats["global_tokens"]}
+    if stats["global_tokens"] >= max(1, min_tokens):
+        score = stats["global_sum"] / stats["global_tokens"]
+        stats["heads"] = torch.topk(score, min(top, score.numel())).indices.sort().values
+        metrics["selector/svh_top_score"] = float(score[stats["heads"]].mean())
+        metrics["selector/svh_mean_score"] = float(score.mean())
+    metrics["selector/svh_ready"] = float(stats["heads"] is not None)
+    return metrics
+
+
+def box_selector_loss(records, evidence, stats: Optional[dict], *, box_coef: float, svh_coef: float):
+    """BG-OPD auxiliary loss: box_coef * mean box CE + svh_coef * mean_i KL(visual-head attention || softmax(s_i)).
+    Also accumulates the SparseMM head scores of this micro-batch into ``stats['local_*']``."""
+    metrics: dict[str, float] = {}
+    terms = []
+    box = [record for record in records if record.get("box_loss") is not None]
+    if box:
+        box_loss = torch.stack([record["box_loss"] for record in box]).mean()
+        metrics["selector/box_ce"] = float(box_loss.detach())
+        metrics["selector/box_images"] = float(len(box))
+        recall = [record["recall"] for record in box if "recall" in record]
+        if recall:
+            metrics["selector/box_recall_at_budget"] = sum(recall) / len(recall)
+        if box_coef > 0:
+            terms.append(box_coef * box_loss)
+    if evidence and stats is not None:
+        hit_tokens, kl_terms, mismatched = 0, [], 0
+        heads = stats.get("heads")
+        for record in _ordered_records(records):
+            entry = evidence.get((record["row"], record["span"]))
+            if entry is None:
+                continue
+            dist = entry["dist"]
+            scores = record["scores"].float()
+            if dist.shape[1] != scores.numel():
+                mismatched += 1
+                continue
+            mask = record.get("answer_mask")
+            hits = entry["hits"]
+            if mask is not None and hits is not None and bool(mask.any()):
+                mask = mask.to(hits.device)
+                inside = (hits >= 0) & mask[hits.clamp_min(0)]
+                stats["local_sum"] += (inside.double().sum(dim=1) / float(mask.sum())).cpu()
+                stats["local_tokens"] += float(hits.shape[1])
+                hit_tokens += hits.shape[1]
+            if heads is not None and svh_coef > 0:
+                target = dist.index_select(0, heads.to(dist.device)).float().mean(dim=0)
+                target = (target / target.sum().clamp_min(1e-12)).to(scores.device).clamp_min(1e-12)
+                kl_terms.append((target * (target.log() - torch.log_softmax(scores, dim=0))).sum())
+        metrics["selector/svh_hit_tokens"] = float(hit_tokens)
+        metrics["selector/svh_mismatched"] = float(mismatched)
+        if kl_terms:
+            kl = torch.stack(kl_terms).mean()
+            metrics["selector/svh_kl"] = float(kl.detach())
+            terms.append(svh_coef * kl)
+    if not terms:
+        return None, metrics
+    return sum(terms), metrics
