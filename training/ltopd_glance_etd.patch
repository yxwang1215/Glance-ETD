+class TokenImportanceScorer(nn.Module):
+    """LES scorer: post-merger visual embedding -> scalar evidence score.
+
+    The output layer is zero-initialised, so every token scores 0 at step 0 and selection is exactly DivPrune.
+    Inputs are detached: the scorer never sends gradients into the vision tower.
+    """
+
+    def __init__(self, input_hidden_size: int, hidden_size: int = 64) -> None:
+        super().__init__()
+        self.input = nn.Linear(int(input_hidden_size), int(hidden_size))
+        self.output = nn.Linear(int(hidden_size), 1)
+        self.reset_parameters()
+
+    def reset_parameters(self) -> None:
+        nn.init.normal_(self.input.weight, std=0.02)
+        nn.init.zeros_(self.input.bias)
+        nn.init.zeros_(self.output.weight)
+        nn.init.zeros_(self.output.bias)
+
+    def forward(self, embeds: torch.Tensor) -> torch.Tensor:
+        weight = self.input.weight
+        x = embeds.detach().to(weight.dtype)
+        x = torch.nn.functional.layer_norm(x, (x.shape[-1],))
+        return self.output(torch.nn.functional.gelu(self.input(x))).squeeze(-1).float()
+
+    @staticmethod
+    def multipliers(
+        scores: torch.Tensor, *, strength: float, clip: float, noise: Optional[torch.Tensor] = None,
+    ) -> torch.Tensor:
+        """exp(lambda * clip(s - mean(s))): centred but NOT standardised, so the learned score scale is the
+        selector's confidence. Scores start at exactly 0 (zero-init head) -> all-ones -> plain DivPrune, and the
+        selection departs from DivPrune only as fast as the scorer actually learns."""
+        scores = scores.detach().float()
+        if not bool(torch.isfinite(scores).all().item()):
+            raise FloatingPointError("LES scores contain NaN or Inf")
+        centred = (scores - scores.mean()).clamp(-clip, clip)
+        if noise is None:
+            return torch.exp(strength * centred)
+        # PGS exploration: Gumbel-perturbed log-multipliers, bounded so a single draw cannot dominate DivPrune.
+        return torch.exp((strength * centred + noise.to(centred)).clamp(-2.0 * strength * clip - 6.0,
+                                                                         2.0 * strength * clip + 6.0))
+
