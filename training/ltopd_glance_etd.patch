+    c_i is cross-attention of h_i over the question tokens.  w_o and w_r start at zero, so every token scores
+    exactly 0 at step 0 and selection is plain DivPrune.  Inputs are detached: the scorer never trains the
+    vision tower or the word embeddings.  With num_slots > 0 it also owns the QSlot soft-patch generator.
+    """
+
+    def __init__(self, input_hidden_size: int, hidden_size: int = 64, num_slots: int = 0) -> None:
+        super().__init__()
+        d, h = int(input_hidden_size), int(hidden_size)
+        self.hidden_size = h
+        self.input = nn.Linear(d, h)
+        self.query_key = nn.Linear(d, h)
