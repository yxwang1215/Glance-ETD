@@ -0,0 +1,315 @@
+"""ViT-side acceleration for the LT-OPD student .
+
+At 5% visual-token retention the LLM prefill on HR-4K drops to ~90 ms, while the Qwen3.5 vision tower (24 global
+attention blocks, ~50k patches) still costs 1.7-2.6 s; ~89% of its FLOPs are the N^2 attention term. EC-OPD
+(experiment/encoder_cut) cuts the tower at block L and only runs [L, 24) on selected tokens; the blocks before L stay
+global. This module attacks the remaining terms and is orthogonal to that cut:
+
+  window  (WinRetro) all blocks except ``global_layers`` attend inside non-overlapping windows of
+          ``window_units`` x ``window_units`` merged tokens (Qwen2.5-VL style hybrid), retrofitted by OPD.
+  glance  (Glance-Gaze) pass 1 encodes the image at 1/2 side length (1/4 patches, 1/16 attention); a DivPrune
+          max-min selection on pass-1 tokens picks ``zoom_ratio`` of the coarse cells; pass 2 encodes only the
+          native-resolution patches of those cells. The output is the full native merged grid: zoomed cells carry
+          pass-2 tokens, the rest carry their coarse token copied to the 2x2 native cells, so the downstream selector,
+          budget (5% of the native N) and M-RoPE positions are unchanged. ``zoom_ratio=0`` is the low-resolution
+          control (encode at 1/4 area, upsample tokens). ``pass2_window`` additionally windows pass 2.
+
+Only images with at least ``min_patches`` ViT patches take the efficient path; smaller images (ViT < 40 ms) and
+videos stay dense. Only the student path ("merge" compression) uses it: the dense teacher and full-token evaluation
+call the stock tower. No new parameters, so exports and evaluation loaders are unchanged.
+
+Training aid: with ``feature_distill_coef > 0`` and grad enabled, the stock dense tower (same weights, no grad) gives a
+per-token target and ``1 - cos`` on the merger outputs is recorded for the actor to add to its loss.
+"""
+from __future__ import annotations
+
+import math
+from typing import Any, Mapping, Optional
+
+import torch
+import torch.nn.functional as F
+
+EFFICIENT_VIT_MODES = ("off", "window", "glance")
+_DEFAULTS = {
+    "mode": "off",
+    "min_patches": 4096,
+    "window_units": 8,
+    "global_layers": [5, 11, 17, 23],
+    "zoom_ratio": 0.25,
+    "pass2_window": False,
+    "feature_distill_coef": 0.0,
+}
+
+
+def validate_efficient_vit_config(config: Optional[Mapping[str, Any]]) -> dict[str, Any]:
+    out = dict(_DEFAULTS)
+    if config:
+        unknown = set(config) - set(_DEFAULTS)
+        if unknown:
+            raise ValueError(f"Unknown efficient_vit keys: {sorted(unknown)}")
+        out.update(config)
+    if out["mode"] not in EFFICIENT_VIT_MODES:
+        raise ValueError(f"efficient_vit.mode must be one of {EFFICIENT_VIT_MODES}")
+    out["min_patches"] = int(out["min_patches"])
+    out["window_units"] = int(out["window_units"])
+    out["global_layers"] = sorted(int(i) for i in out["global_layers"])
+    out["zoom_ratio"] = float(out["zoom_ratio"])
+    out["pass2_window"] = bool(out["pass2_window"])
+    out["feature_distill_coef"] = float(out["feature_distill_coef"])
+    if out["window_units"] < 1 or not 0.0 <= out["zoom_ratio"] <= 1.0 or out["feature_distill_coef"] < 0:
+        raise ValueError(f"invalid efficient_vit config {out}")
+    out["enabled"] = out["mode"] != "off"
+    return out
+
+
+# ----------------------------------------------------------------------------------------------------------- helpers
+def _rope(visual, grid: torch.Tensor):
+    rot = visual.rot_pos_emb(grid)
+    rot = rot.reshape(rot.shape[0], -1)
+    emb = torch.cat((rot, rot), dim=-1)
+    return emb.cos(), emb.sin()
+
+
+def _embed(visual, pixel_values: torch.Tensor, grid: torch.Tensor):
+    hidden = visual.patch_embed(pixel_values)
+    hidden = hidden + visual.fast_pos_embed_interpolate(grid)
+    return hidden.reshape(hidden.shape[0], -1), _rope(visual, grid)
+
+
+def _cu(lengths: list[int], device) -> torch.Tensor:
+    return F.pad(torch.tensor(lengths, device=device, dtype=torch.int32).cumsum(0, dtype=torch.int32), (1, 0))
+
+
+def window_permutation(grid_rows: list[tuple[int, int, int]], window_units: int, merge: int = 2):
+    """Patch permutation that makes every window contiguous, plus window lengths (in patches).
+
+    Patches arrive as (t, h/m, w/m, m, m); a merged unit is m*m consecutive patches. Units are stably sorted by
+    (image, frame, window row, window col), so the inverse permutation restores the processor order exactly.
+    """
+    unit = merge * merge
+    perms, lengths, offset = [], [], 0
+    for t, h, w in grid_rows:
+        gh, gw = h // merge, w // merge
+        r = torch.arange(gh).view(gh, 1).expand(gh, gw)
+        c = torch.arange(gw).view(1, gw).expand(gh, gw)
+        nwc = math.ceil(gw / window_units)
+        key = ((r // window_units) * nwc + c // window_units).reshape(-1)
+        per_frame = gh * gw
+        for ti in range(t):
+            order = torch.sort(key, stable=True).indices
+            units = order + ti * per_frame
+            perms.append((units.view(-1, 1) * unit + torch.arange(unit).view(1, -1)).reshape(-1) + offset)
+            lengths.extend((torch.bincount(key) * unit).tolist())
+        offset += t * h * w
+    perm = torch.cat(perms)
+    lengths = [n for n in lengths if n > 0]
+    return perm, lengths
+
+
+def _run_blocks(visual, hidden, pos, cu_full, cu_win=None, global_layers=()):
+    for index, block in enumerate(visual.blocks):
+        cu = cu_full if (cu_win is None or index in global_layers) else cu_win
+        hidden = block(hidden, cu_seqlens=cu, position_embeddings=pos)
+    return hidden
+
+
+def window_forward(visual, pixel_values: torch.Tensor, grid: torch.Tensor, cfg: Mapping[str, Any]) -> torch.Tensor:
+    """Hybrid window/global tower; returns merger outputs in processor order."""
+    rows = [tuple(int(v) for v in row) for row in grid.tolist()]
+    merge = visual.spatial_merge_size
+    hidden, (cos, sin) = _embed(visual, pixel_values, grid)
+    perm, win_lengths = window_permutation(rows, cfg["window_units"], merge)
+    perm = perm.to(hidden.device)
+    hidden, cos, sin = hidden[perm], cos[perm], sin[perm]
+    cu_full = _cu([h * w for t, h, w in rows for _ in range(t)], hidden.device)
+    cu_win = _cu(win_lengths, hidden.device)
+    hidden = _run_blocks(visual, hidden, (cos, sin), cu_full, cu_win, set(cfg["global_layers"]))
+    inverse = torch.empty_like(perm)
+    inverse[perm] = torch.arange(perm.numel(), device=perm.device)
+    return visual.merger(hidden[inverse])
+
+
+def _patches_to_image(patches: torch.Tensor, h: int, w: int, p: int, tp: int, merge: int = 2) -> torch.Tensor:
+    c = patches.shape[1] // (tp * p * p)
+    x = patches.view(h // merge, w // merge, merge, merge, c, tp, p, p)
+    return x.permute(5, 4, 0, 2, 6, 1, 3, 7).reshape(tp, c, h * p, w * p)[0]
+
+
+def _image_to_patches(image: torch.Tensor, p: int, tp: int, merge: int = 2) -> torch.Tensor:
+    c, hh, ww = image.shape
+    h, w = hh // p, ww // p
+    x = image.view(c, h // merge, merge, p, w // merge, merge, p)  # c, gh, i, y, gw, j, x
+    x = x.permute(1, 4, 2, 5, 0, 3, 6)  # gh, gw, i, j, c, y, x
+    x = x.unsqueeze(5).expand(*x.shape[:5], tp, p, p)
+    return x.reshape(h * w, c * tp * p * p)
+
+
+def downsample_patches(patches: torch.Tensor, h: int, w: int, p: int, tp: int, merge: int = 2):
+    """2x area-average downsample in normalized pixel space; pads to a multiple of 2*merge patches first."""
+    image = _patches_to_image(patches.float(), h, w, p, tp, merge)
+    step = 2 * merge
+    h4, w4 = math.ceil(h / step) * step, math.ceil(w / step) * step
+    image = F.pad(image, (0, (w4 - w) * p, 0, (h4 - h) * p))  # 0 == channel mean after normalization
+    low = F.avg_pool2d(image.unsqueeze(0), 2).squeeze(0)
+    return _image_to_patches(low, p, tp, merge).to(patches.dtype), h4 // 2, w4 // 2
+
+
+def _max_min_select(features: torch.Tensor, count: int) -> torch.Tensor:
+    """DivPrune greedy max-min cosine diversity, centroid seed (same rule as the LT-OPD selector)."""
+    from verl.models.transformers.vision_token_compressor import _greedy_max_min_diversity
+
+    normalized = F.normalize(features.float(), dim=-1)
+    return _greedy_max_min_diversity(normalized, output_tokens=int(count), seed="centroid")
+
+
+def glance_forward_one(visual, patches: torch.Tensor, h: int, w: int, cfg: Mapping[str, Any]):
+    """Glance-Gaze for one image (t == 1); returns [h/2 * w/2, out_dim] in processor order and stats."""
+    merge = visual.spatial_merge_size
+    p = visual.patch_embed.patch_size
+    tp = visual.patch_embed.temporal_patch_size
+    device = patches.device
+    gh, gw = h // merge, w // merge
+    low, lh, lw = downsample_patches(patches, h, w, p, tp, merge)
+    low_grid = torch.tensor([[1, lh, lw]], device=device)
+    hidden, pos = _embed(visual, low, low_grid)
+    cu = _cu([lh * lw], device)
+    low_out = visual.merger(_run_blocks(visual, hidden, pos, cu))  # [lh/2 * lw/2, D]
+    lgh, lgw = lh // merge, lw // merge
+    rows = torch.arange(gh, device=device).view(gh, 1).expand(gh, gw)
+    cols = torch.arange(gw, device=device).view(1, gw).expand(gh, gw)
+    coarse_of_native = ((rows // 2) * lgw + cols // 2).reshape(-1)
+    output = low_out.index_select(0, coarse_of_native)
+    stats = {"zoom_cells": 0, "pass1_patches": lh * lw, "pass2_patches": 0}
+    ratio = float(cfg["zoom_ratio"])
+    if ratio <= 0.0:
+        return output, stats
+    # Coarse cells that cover at least one real (unpadded) native cell are candidates.
+    crow = torch.arange(lgh, device=device).view(lgh, 1).expand(lgh, lgw)
+    ccol = torch.arange(lgw, device=device).view(1, lgw).expand(lgh, lgw)
+    valid = ((crow * 2 < gh) & (ccol * 2 < gw)).reshape(-1).nonzero().squeeze(1)
+    count = max(1, min(valid.numel(), round(ratio * valid.numel())))
+    with torch.no_grad():
+        chosen = valid.index_select(0, _max_min_select(low_out.detach().index_select(0, valid), count).to(device))
+    chosen = torch.sort(chosen).values
+    cr, cc = chosen // lgw, chosen % lgw
+    da = torch.tensor([0, 0, 1, 1], device=device)
+    db = torch.tensor([0, 1, 0, 1], device=device)
+    nr, nc = (cr.view(-1, 1) * 2 + da).reshape(-1), (cc.view(-1, 1) * 2 + db).reshape(-1)
+    keep = (nr < gh) & (nc < gw)
+    native_units = torch.sort((nr * gw + nc)[keep]).values
+    unit = merge * merge
+    patch_index = (native_units.view(-1, 1) * unit + torch.arange(unit, device=device).view(1, -1)).reshape(-1)
+    grid = torch.tensor([[1, h, w]], device=device)
